{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"meowseum://one-shot-sources/v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","museumId","workId","sources","directQuotes","highRiskClaims","uncertainties"],
  "properties":{
    "schemaVersion":{"enum":[1]},
    "museumId":{"type":"string","minLength":1},
    "workId":{"type":"string","minLength":1},
    "sources":{"type":"array","minItems":1,"items":{"type":"object","required":["title","publisher","url","sourceType","usedFor"],"properties":{"id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"publisher":{"type":"string","minLength":1},"url":{"type":"string","format":"uri"},"sourceType":{"enum":["museum","academic","foundation","publication","media","other"]},"usedFor":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}}},
    "directQuotes":{"type":"array"},
    "highRiskClaims":{"type":"array"},
    "uncertainties":{"type":"array"}
  }
}
