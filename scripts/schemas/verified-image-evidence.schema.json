{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meowseum://verified-image-evidence/v1",
  "type": "object",
  "required": ["schemaVersion", "museumId", "works"],
  "properties": {
    "schemaVersion": {"const": 1},
    "museumId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workId", "identity", "status", "selected"],
        "properties": {
          "workId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "identity": {
            "type": "object",
            "required": ["title", "accessionNumber", "officialObjectUrl"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "creator": {"type": "string"},
              "accessionNumber": {"type": "string", "minLength": 1},
              "officialObjectUrl": {"type": "string", "format": "uri"}
            }
          },
          "status": {"const": "accepted"},
          "selected": {
            "type": "object",
            "required": ["url", "localPath", "sha256", "width", "height", "contentType", "method", "provider", "identitySignals"],
            "properties": {
              "url": {"type": "string", "format": "uri"},
              "localPath": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1},
              "contentType": {"enum": ["image/jpeg", "image/png", "image/webp", "image/gif", "image/tiff"]},
              "method": {"type": "string", "minLength": 1},
              "provider": {"type": "string", "minLength": 1},
              "identitySignals": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "alternatives": {"type": "array"},
          "warnings": {"type": "array"}
        }
      }
    }
  }
}
