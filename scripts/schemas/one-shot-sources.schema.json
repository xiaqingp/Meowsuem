{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meowseum://one-shot-sources/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "museumId", "workId", "sources", "directQuotes", "highRiskClaims", "uncertainties"],
  "properties": {
    "schemaVersion": {"enum": [2]},
    "museumId": {"type": "string", "minLength": 1},
    "workId": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "publisher", "url", "sourceType", "usedFor"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "sourceType": {"enum": ["museum", "academic", "foundation", "publication", "media", "other"]},
          "usedFor": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "directQuotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quote", "speaker"],
        "anyOf": [
          {"required": ["sourceId"]},
          {"required": ["sourceUrl"]},
          {"required": ["sourceIds"]},
          {"required": ["sourceUrls"]}
        ],
        "properties": {
          "quote": {"type": "string", "minLength": 1},
          "speaker": {"type": "string", "minLength": 1},
          "sourceId": {"type": "string", "minLength": 1},
          "sourceUrl": {"type": "string", "format": "uri"},
          "sourceIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "sourceUrls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}}
        }
      }
    },
    "highRiskClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "type"],
        "anyOf": [
          {"required": ["sourceIds"]},
          {"required": ["sourceUrls"]}
        ],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "type": {"enum": ["first_or_earliest", "only_or_unique", "largest_or_most", "foundational", "artist_intent", "attribution", "other"]},
          "sourceIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "sourceUrls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}}
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "statement"],
        "properties": {
          "topic": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "sourceIds": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "upstreamConflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "lockedValue", "observedValue", "severity", "explanation"],
        "properties": {
          "field": {"enum": ["identity", "creator", "attribution", "date", "medium", "accessionNumber", "availability", "collectionRelation", "rare", "significance"]},
          "lockedValue": {},
          "observedValue": {},
          "sourceIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "severity": {"enum": ["warning", "blocking"]},
          "explanation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
