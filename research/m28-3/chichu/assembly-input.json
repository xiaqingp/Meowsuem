  "chapters": [
    {
      "id": "buried-museum",
      "number": "01",
      "title": "建筑消失以后，靠什么带你进入地下？",
      "intro": "从地表轮廓到入口、坡道和两座庭院，解释“地中”不是外形噱头，而是一套用遮挡、转折、几何与露天开口建立方向的路线。"
    },
    {
      "id": "measured-daylight",
      "number": "02",
      "title": "自然光既然会变，展厅怎样把变化变成秩序？",
      "intro": "说明自然光并非未经设计地落入地下；开口、吊顶、材料和测光共同让时间可见，并为莫奈作品建立专用环境。"
    },
    {
      "id": "monet-water",
      "number": "03",
      "title": "没有岸和地平线，莫奈怎样只用水面撑起五幅画？",
      "intro": "以建馆契机的六米双联画为核心，对照方形、横幅、草丛和柳影，讲清莫奈晚期如何用浮叶、反射与松散笔触替代传统远景。"
    },
    {
      "id": "turrell-perception",
      "number": "04",
      "title": "光什么时候像物体，什么时候又像一间房？",
      "intro": "按1968、2000、2004年的顺序比较塔瑞尔从墙角投影、空间开口到真实天空的三种方法，让观众用移动和颜色对比检查自己的知觉。"
    },
    {
      "id": "changing-time",
      "number": "05",
      "title": "不动的石球与生长的庭园，怎样各自记录时间？",
      "intro": "以德·玛利亚的固定几何和地中庭园的季节变化收束全馆：时间既能通过光在材料上的移动显现，也能通过植物的生长与花期显现。"
    }
  ],
