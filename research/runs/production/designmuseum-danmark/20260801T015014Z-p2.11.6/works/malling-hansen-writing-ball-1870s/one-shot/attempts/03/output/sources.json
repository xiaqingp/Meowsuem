  "highRiskClaims": [
    {
      "claim": "汉森写字球通常被认为是世界上第一种商业化生产的打字机。",
      "type": "first_or_earliest",
      "sourceIds": [
        "S2",
        "S3"
      ]
    },
    {
      "claim": "历史上大约生产了180台汉森写字球，约30台留存至今。",
      "type": "other",
      "sourceIds": [
        "S2",
        "S4"
      ]
    },
    {
      "claim": "典型汉森写字球有54根带弹簧的字杆，以不同角度汇聚到共同的打字点，并配有空格、自动换行和回车、响铃、复写等机制。",
      "type": "other",
      "sourceIds": [
        "S2"
      ]
    },
    {
      "claim": "尼采因视力严重恶化使用汉森写字球，机器于1882年2月抵达热那亚。",
      "type": "other",
      "sourceIds": [
        "S4"
      ]
    },
    {
      "claim": "汉森写字球的设计背景与Malling-Hansen在哥本哈根面向聋人学生的学校工作有关，目标是让手指成为更有效的书写和交流工具。",
      "type": "artist_intent",
      "sourceIds": [
        "S2"
      ]
    }
  ],
