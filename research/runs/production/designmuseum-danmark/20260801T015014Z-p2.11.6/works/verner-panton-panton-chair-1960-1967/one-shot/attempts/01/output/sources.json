  "highRiskClaims": [
    {
      "claim": "Designmuseum Danmark称潘顿椅是世界上第一把量产的、由单块塑料构成的椅子，椅腿、座面和靠背为一体。",
      "type": "first_or_earliest",
      "sourceIds": [
        "S1"
      ]
    },
    {
      "claim": "潘顿椅于1967年首次公开呈现，并在1968年以硬质聚氨酯泡沫和新的成形工艺进入量产阶段。",
      "type": "other",
      "sourceIds": [
        "S2",
        "S3"
      ]
    },
    {
      "claim": "1967年早期生产版本采用冷模成形的玻璃纤维增强聚酯树脂，并曾以约150件的小批量形式制作。",
      "type": "other",
      "sourceIds": [
        "S3"
      ]
    }
  ],
