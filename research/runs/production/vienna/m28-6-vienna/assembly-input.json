  "chapters": [
    {
      "id": "vienna-ch-01-building",
      "number": "01",
      "title": "为什么还没看藏品，博物馆已经开始讲权力？",
      "intro": "建立整馆最小解释模型，说明建筑不是中性容器，而是收藏公开化后的第一件解释工具。"
    },
    {
      "id": "vienna-ch-02-power",
      "number": "02",
      "title": "权力怎样把自己刻进宝石、青铜和货币？",
      "intro": "把图像宣称、法律执行、王朝配对和货币传播区分开，同时显示权力并不只存在于大型历史画。"
    },
    {
      "id": "vienna-ch-03-afterlife-story",
      "number": "03",
      "title": "一件古物怎样让死者、神话和仪式继续运作？",
      "intro": "从原始用途进入古物收藏，避免把所有古代对象只看成独立雕塑或漂亮图案。"
    },
    {
      "id": "vienna-ch-04-kunstkammer",
      "number": "04",
      "title": "当材料比用途更重要，器物会变成什么？",
      "intro": "解释艺术珍宝馆并非杂物柜，而是一套比较材料、技术、运动、古典复兴和宫廷展示的知识系统。"
    },
    {
      "id": "vienna-ch-05-bruegel",
      "number": "05",
      "title": "勃鲁盖尔怎样把一个世界压进一块画板？",
      "intro": "把本馆最强的单一画家收藏读成一组观看方法，而不是五张名作清单；《巴别塔》和《雪中猎人》共同支撑一条稀世珍品线。"
    },
    {
      "id": "vienna-ch-06-painting",
      "number": "06",
      "title": "一幅画何时不再只是再现对象？",
      "intro": "以维米尔的绘画自我指涉为核心，连接宫廷身份、文艺复兴构图、威尼斯晚期笔触、矫饰主义错觉及宗教叙事。"
    }
  ],
