  "highRiskClaims": [
    {
      "claim": "现行组合于1840年为卡罗琳·阿玛莉娅王后制作，并由她在同年受膏礼时佩戴。",
      "type": "other",
      "sourceIds": [
        "S1",
        "S2",
        "S3"
      ]
    },
    {
      "claim": "项链中的大型泪滴形钻石原属索菲·玛格达莱娜王后的发簪；中央附近的大颗钻石曾镶在克里斯蒂安七世于1766年送给卡罗琳·马蒂尔德王后的戒指中。",
      "type": "other",
      "sourceIds": [
        "S1"
      ]
    },
    {
      "claim": "胸针最大的一朵花装在螺旋弹簧上，佩戴时会振动以增强钻石的光线效果。",
      "type": "other",
      "sourceIds": [
        "S1"
      ]
    }
  ],
  "uncertainties": [
    {
      "topic": "individualDisplayStatus",
      "statement": "官方资料说明丹麦冠珠宝在罗斯堡宫宝库展示，同时可供现任王后在正式场合使用；但未明确保证这套套饰在某一具体参观日期必然单独陈列，因此实际可见性可能受馆藏轮换和王室使用影响。"
    },
    {
      "topic": "diamondProvenance",
      "statement": "关于其中一颗明亮式钻石曾在1721年婚礼上由索菲·玛格达莱娜送给克里斯蒂安王子并镶入戒指的说法，官方对象页使用了推测性表述；本文未将该说法写成确定事实。"
    },
    {
      "topic": "metalComposition",
      "statement": "已核对的官方英文对象页和宝库页面重点说明了套饰构成、来源与制作年代，未在页面正文完整列出金银镶座的技术组成；本文因此主要依据已验证图像描述镶座的视觉色泽，不作金属比例或纯度判断。"
    }
  ],
