    {
      "claim": "王座由本迪克斯·格罗德茨希灵制作，鎏金人物由 J. Kohlmann 制作并在克里斯蒂安五世时期加入。",
      "type": "attribution",
      "sourceIds": [
        "S2"
      ]
    },
    {
      "claim": "王座首次用于1671年克里斯蒂安五世的涂油典礼，最后用于1840年克里斯蒂安八世的涂油典礼。",
      "type": "other",
      "sourceIds": [
        "S2",
        "S3"
      ]
    },
    {
      "claim": "王座以《圣经》中所罗门王的象牙王座为设计模型，弗雷德里克三世选择了当时被称作独角兽角的独角鲸牙，并且知道这些材料实际来自独角鲸。",
      "type": "other",
      "sourceIds": [
        "S1",
        "S3"
      ]
    }
  ],
